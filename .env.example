AIRTABLE_API_KEY=patXXXXXXXXXXXXXX
AIRTABLE_BASE_ID=appHYcz1rdao0Evm6

# Same Mailchimp Marketing API v3 credentials cmdf-website's subscribe.js
# uses. Adds each party's email to this audience on check-in; a Mailchimp
# automation (not this app) is what actually sends a welcome/thank-you email.
# If unset, syncing is skipped (logged, not an error).
MAILCHIMP_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-usXX
MAILCHIMP_SERVER_PREFIX=usXX
MAILCHIMP_AUDIENCE_ID=xxxxxxxxxx

# Shared password volunteers use to log in at /login. Pick something long and
# random (not a dictionary word) — there's no login-attempt lockout in v1.
VOLUNTEER_PASSWORD=change-me

# Signs the volunteer session cookie. Generate with: openssl rand -hex 32
SESSION_SECRET=change-me
